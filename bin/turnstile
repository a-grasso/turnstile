#!/usr/bin/env bash
# turnstile - a mechanical gate on the push path.
#
# Not a skill, not an agent. A git pre-push hook that runs a repo's own
# deterministic checks and refuses the push if they fail. Fires because the
# code path was taken, not because a model decided it was relevant.
#
# See README.md for the design and the install story.

set -uo pipefail

TURNSTILE_VERSION="0.2.0-prototype"

# ---------------------------------------------------------------- paths

# Resolve this script's real location without relying on `readlink -f`.
_resolve_self() {
  local src="${BASH_SOURCE[0]}" dir
  while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && pwd
}

TURNSTILE_BIN="$(_resolve_self)"
TURNSTILE_HOME="$(dirname "$TURNSTILE_BIN")"
export TURNSTILE_HOME

HOOKS_INSTALL_DIR="${TURNSTILE_HOOKS_DIR:-$HOME/.turnstile/hooks}"

# Client-side hooks the dispatcher must shadow once core.hooksPath is global.
# Anything not listed here stops firing for every repo, so the list is the
# contract - not a convenience.
GIT_HOOKS=(
  applypatch-msg pre-applypatch post-applypatch
  pre-commit pre-merge-commit prepare-commit-msg commit-msg post-commit
  pre-rebase post-checkout post-merge pre-push
  post-rewrite pre-auto-gc push-to-checkout sendemail-validate
)

# ---------------------------------------------------------------- output

if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
  C_RESET=$'\033[0m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'
  C_RED=$'\033[31m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'
  CLEAR_LINE=$'\r\033[K'
else
  C_RESET=''; C_DIM=''; C_BOLD=''; C_RED=''; C_GREEN=''; C_YELLOW=''
  # Redirected output gets no in-progress line to erase, so nothing to clear -
  # emitting the escape anyway litters CI logs with stray [K.
  CLEAR_LINE=''
fi

say()  { printf '%s\n' "$*" >&2; }
dim()  { printf '%s%s%s\n' "$C_DIM" "$*" "$C_RESET" >&2; }
warn() { printf '%s! %s%s\n' "$C_YELLOW" "$*" "$C_RESET" >&2; }
die()  { printf '%sx %s%s\n' "$C_RED" "$*" "$C_RESET" >&2; exit 1; }

# ---------------------------------------------------------------- config

CONFIG_NAME=".turnstile"

repo_root() { git rev-parse --show-toplevel 2>/dev/null; }

config_path() {
  if [ -n "${CONFIG_OVERRIDE:-}" ]; then printf '%s' "$CONFIG_OVERRIDE"; return; fi
  local root; root="$(repo_root)" || return 1
  [ -n "$root" ] && printf '%s/%s' "$root" "$CONFIG_NAME"
}

# Emits "name<US>scope<US>tier<US>command" (US = \\037) per configured *deterministic* check.
#
# Format is deliberately line-oriented rather than YAML/TOML: no parser
# dependency, and a config that cannot express anything but a list of commands
# cannot grow into a second configuration language.
#
#   # comment
#   lint: make lint
#   cli [cli/** go.work]: make -C cli test    <- runs only when the change touches these
#   push e2e [web/**]: make e2e               <- too slow for every agent turn; push and CI only
#   ai review: block=high     <- not a command; owned by bin/turnstile-ai
#   intent: gh issue view ... <- not a check; feeds the ai modules
#
# `ai <name>:` and `intent:` lines are filtered out here rather than parsed.
# This function's output is fed straight to `eval`, so leaking one through
# would execute `block=high`, or run the intent command as if it were a check.
read_checks() {
  local cfg; cfg="$(config_path)" || return 1
  [ -f "$cfg" ] || return 1
  # shellcheck disable=SC2162
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line#"${line%%[![:space:]]*}"}"          # ltrim
    [ -z "$line" ] && continue
    case "$line" in \#*) continue ;; esac
    case "$line" in *:*) ;; *) continue ;; esac
    local name="${line%%:*}" cmd="${line#*:}"
    name="${name%"${name##*[![:space:]]}"}"          # rtrim
    cmd="${cmd#"${cmd%%[![:space:]]*}"}"             # ltrim
    [ -z "$cmd" ] && continue
    # The `ai` prefix is reserved for module declarations. A line that claims
    # it but carries no `k=v` option is almost certainly a deterministic check
    # written before the prefix existed - say so instead of dropping it, since
    # silently losing a check is the one failure a gate must never have.
    case "$name" in
      ai\ *|ai)
        case "$cmd" in
          *=*) ;;
          *) warn "turnstile: '$name' looks like a check, but 'ai' is reserved for modules - ignoring it" ;;
        esac
        continue
        ;;
      intent) continue ;;
    esac
    local scope="" tier=""
    case "$name" in
      push\ ?*)
        tier=push
        name="${name#push }"; name="${name#"${name%%[![:space:]]*}"}"
        ;;
    esac
    case "$name" in
      *\[*\])
        scope="${name#*\[}"; scope="${scope%\]}"
        name="${name%%\[*}"; name="${name%"${name##*[![:space:]]}"}"
        ;;
    esac
    printf '%s\037%s\037%s\037%s\n' "$name" "$scope" "$tier" "$cmd"
  done < "$cfg"
}

# Emits "name<TAB>options" per configured AI module. Display and
# has-any-configured purposes only - bin/turnstile-ai parses the config itself
# so that it stays runnable with no bash gate installed.
read_ai_checks() {
  local cfg; cfg="$(config_path)" || return 1
  [ -f "$cfg" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line#"${line%%[![:space:]]*}"}"
    case "$line" in ai\ *) ;; *) continue ;; esac
    case "$line" in *:*) ;; *) continue ;; esac
    local name="${line%%:*}" opts="${line#*:}"
    name="${name#ai }"
    name="${name#"${name%%[![:space:]]*}"}"
    name="${name%"${name##*[![:space:]]}"}"
    opts="${opts#"${opts%%[![:space:]]*}"}"
    [ -z "$name" ] && continue
    printf '%s\t%s\n' "$name" "$opts"
  done < "$cfg"
}

AI_RUNNER="$TURNSTILE_BIN/turnstile-ai"

# ---------------------------------------------------------------- approval

ALLOWED_DIR="${TURNSTILE_ALLOWED:-$HOME/.turnstile/allowed}"
UNAPPROVED_MESSAGE="turnstile: $CONFIG_NAME changed since you approved it, run \`turnstile allow\` after reviewing it"

# One approval per repo and content, as direnv does: the same file in another
# clone is a different file to approve. The common dir is the identity, so a
# worktree of the repo shares its approvals.
approval_file() {
  local cfg common; cfg="$(config_path)" || return 1
  common="$(cd "$(git rev-parse --git-common-dir)" && pwd -P)" || return 1
  { printf '%s\n' "$common"; cat "$cfg"; } | git hash-object --stdin | sed "s#^#$ALLOWED_DIR/#"
}

# A repo with no config has nothing to approve.
config_approved() {
  local cfg; cfg="$(config_path)" || return 0
  [ -f "$cfg" ] || return 0
  [ -f "$(approval_file)" ]
}

cmd_allow() {
  repo_root >/dev/null || die "not inside a git repository"
  [ -f "$(config_path)" ] || die "no $CONFIG_NAME in $(repo_root) - nothing to approve"
  mkdir -p "$ALLOWED_DIR"
  repo_root >"$(approval_file)"
  say "  ${C_GREEN}✓${C_RESET} approved $CONFIG_NAME in $(repo_root)"
}

# ---------------------------------------------------------------- push range

ZERO="0000000000000000000000000000000000000000"
# A base with no usable fork point: diffing against git's empty tree checks a
# first push in full, where the root commit would drop every file it introduced.
EMPTY_TREE="4b825dc642cb6eb9a060e54bf8d69288fbee4904"

# Reads pre-push stdin ("<local ref> <local sha> <remote ref> <remote sha>")
# and exports the range being pushed, so checks can scope themselves to the
# change instead of walking the whole repo.
#
# Sets: TURNSTILE_RANGE, TURNSTILE_LOCAL_SHA, TURNSTILE_REMOTE_SHA,
#       TURNSTILE_CHANGED_FILES (newline separated)
# Returns 1 when there is nothing to gate (branch deletion, or no refs at all).
# Emits one "<range><TAB><local_ref><TAB><local_sha><TAB><remote_sha>" line per
# content-bearing ref. Every ref is emitted, not just the first: a gate that
# checks one ref of three while reading as having checked all three is the one
# failure mode that makes the whole thing worse than nothing.
compute_ranges() {
  local local_ref local_sha remote_ref remote_sha found=1

  # `|| [ -n "$local_ref" ]` so an unterminated final line is still processed
  # rather than being dropped at EOF.
  while read -r local_ref local_sha remote_ref remote_sha || [ -n "${local_ref:-}" ]; do
    [ -z "${local_sha:-}" ] && continue
    # Deleting a remote branch pushes no content - nothing to validate.
    [ "$local_sha" = "$ZERO" ] && continue

    local range
    # A new remote branch, or a rewritten one (rebase, amend): the old tip is
    # not where this change starts, so diff against the branch it was cut from.
    if [ "$remote_sha" = "$ZERO" ] || [ -z "$remote_sha" ] \
      || ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      local base; base="$(default_base "$local_sha")"
      range="${base}..${local_sha}"
    else
      range="${remote_sha}..${local_sha}"
    fi
    printf '%s\t%s\t%s\t%s\n' "$range" "$local_ref" "$local_sha" "$remote_sha"
    found=0
  done
  return $found
}

# The remote branch the change was cut from, not always the default one: a
# branch off `develop` diffed against `main` drags every unreleased commit into
# the review. Nearest wins, measured as commits between fork point and head;
# ties go to origin/HEAD, then origin/main and origin/master. A head the
# default branch already holds is an empty range; one only some other branch
# holds is still unreviewed.
default_base() {
  local head="$1" nearest refs default contained
  default="$(default_branch_ref || true)"
  # One git call, not two per remote branch: with sixty renovate branches the
  # loop below costs ten seconds, on every agent turn.
  if refs="$(git for-each-ref --format="%(refname) %(ahead-behind:$head)" \
      refs/remotes refs/heads/main refs/heads/master 2>/dev/null)"; then
    nearest="$(awk '$3 > 0 && ($1 == "refs/remotes/origin/HEAD" || $1 !~ /\/HEAD$/) {
        p = $1 == "refs/remotes/origin/HEAD" ? 0 : $1 == "refs/remotes/origin/main" ? 1 \
          : $1 == "refs/remotes/origin/master" ? 2 : $1 ~ /^refs\/remotes\// ? 3 : 4
        print $3, p, $1
      }' <<<"$refs" | sort -n -k1,1 -k2,2 | head -n1 | cut -d' ' -f3)"
    if [ -n "$nearest" ] && git merge-base "$nearest" "$head" 2>/dev/null; then return 0; fi
    if [ -n "$default" ]; then
      contained="$(awk -v ref="refs/remotes/$default" '$1 == ref && $3 == 0 { print $1 }' <<<"$refs")"
      if [ -n "$contained" ]; then printf '%s' "$head"; return 0; fi
    fi
    printf '%s' "$EMPTY_TREE"
    return 0
  fi
  default_base_per_branch "$head" "$default"
}

# git before 2.41 has no %(ahead-behind).
default_base_per_branch() {
  local head="$1" default="${2:-}" b mb ahead best="" best_ahead="" contained=""
  while IFS= read -r b; do
    mb="$(git merge-base "$b" "$head" 2>/dev/null)" || continue
    ahead="$(git rev-list --count "$mb..$head" 2>/dev/null)" || continue
    if [ "$ahead" -eq 0 ]; then
      [ -n "$default" ] && [ "$b" = "$default" ] && contained=1
      continue
    fi
    if [ -z "$best" ] || [ "$ahead" -lt "$best_ahead" ]; then
      best="$mb"; best_ahead="$ahead"
    fi
  done < <(
    for b in origin/HEAD origin/main origin/master; do
      git rev-parse --verify --quiet "$b" >/dev/null 2>&1 && printf '%s\n' "$b"
    done
    git for-each-ref --format='%(refname:short)' refs/remotes | grep -v '/HEAD$'
    printf '%s\n' main master
  )
  if [ -n "$best" ]; then printf '%s' "$best"
  elif [ -n "$contained" ]; then printf '%s' "$head"
  else printf '%s' "$EMPTY_TREE"
  fi
}

# The branch a pull request to the remote would land on, as a remote-tracking
# ref; fails when the remote names none.
default_branch_ref() {
  local remote="${1:-origin}" ref
  if ref="$(git symbolic-ref --quiet --short "refs/remotes/$remote/HEAD" 2>/dev/null)" && [ -n "$ref" ]; then
    printf '%s' "$ref"; return 0
  fi
  for ref in "$remote/main" "$remote/master"; do
    if git rev-parse --verify --quiet "refs/remotes/$ref" >/dev/null 2>&1; then printf '%s' "$ref"; return 0; fi
  done
  return 1
}

# ---------------------------------------------------------------- the change

CHECK_CACHE="${TURNSTILE_CHECK_CACHE:-$HOME/.turnstile/cache/checks}"
CHECK_CACHE_DAYS=30

# An index holding the working tree exactly as it stands, untracked files
# included, built beside the real one so the staging area is never touched. It
# is what makes "the tree the checks ran on" nameable: a pass is cached against
# it, and a check that rewrites files shows up as a different tree.
snapshot_index() {
  local snap real
  snap="$(mktemp "${TMPDIR:-/tmp}/turnstile-index.XXXXXX")" || return 1
  real="$(git rev-parse --git-path index)"
  if [ -f "$real" ]; then cp "$real" "$snap"; else rm -f "$snap"; fi
  if ! GIT_INDEX_FILE="$snap" git add -A >/dev/null 2>&1; then
    rm -f "$snap"
    return 1
  fi
  printf '%s' "$snap"
}

snapshot_tree() { GIT_INDEX_FILE="$SNAPSHOT" git write-tree; }

# Worktree mode reads the snapshot, so uncommitted and untracked work counts.
# Push mode reads the pushed range, which is what actually leaves the machine.
change_diff() {
  if [ "$TURNSTILE_MODE" = worktree ]; then
    GIT_INDEX_FILE="$SNAPSHOT" git -c core.quotePath=false diff --cached "$@"
  else
    git -c core.quotePath=false diff "$@"
  fi
}

# Optional pathspecs restrict the answer to a check's scope.
changed_names() {
  local rev="$TURNSTILE_RANGE"
  [ "$TURNSTILE_MODE" = worktree ] && rev="$TURNSTILE_BASE"
  change_diff --name-only "$rev" -- "$@"
}

change_patch() {
  local rev="$TURNSTILE_RANGE"
  [ "$TURNSTILE_MODE" = worktree ] && rev="$TURNSTILE_BASE"
  change_diff "$rev"
}

# What a check can see: the whole tree, or only the files in its scope. A scoped
# check keeps its cached pass while edits land elsewhere.
content_key() {
  if [ $# -eq 0 ]; then
    snapshot_tree
  else
    GIT_INDEX_FILE="$SNAPSHOT" git ls-files -s -- "$@" | git hash-object --stdin
  fi
}

# The base is part of the key because checks also read the changed-file list and
# the diff, and both move with it.
check_key() {
  printf 'turnstile-check-v1\n%s\n%s\n%s\n%s\n' "$1" "$2" "$TURNSTILE_BASE" "$3" \
    | git hash-object --stdin
}

# ---------------------------------------------------------------- run checks

# Exit status a check uses for "cannot run here" (autotools' skip code): not a
# failure, never cached, and counted in the summary so a quiet gate never reads
# as a thorough one.
SKIP_STATUS=77

# The last line of a log that says something: blank lines, bare punctuation and
# make's own "*** Error" trailer are what a failing command ends in.
last_line() {
  grep -v -E '^[[:space:]]*([[:punct:]]*|make(\[[0-9]+\])?: \*\*\*.*)$' "$1" \
    | tail -n 1 | sed -e 's/^[[:space:]]*//' | cut -c1-160
}

# Runs every configured check, buffering output and surfacing it only on
# failure. Returns the number of failures.
#
# Callers set TURNSTILE_MODE (worktree|push), TURNSTILE_BASE and
# TURNSTILE_RANGE. Checks additionally get TURNSTILE_CHANGED_FILES and
# TURNSTILE_DIFF_FILE.
#
# TRUST: `.turnstile` is executed with `eval`. It is repo content, so cloning a
# hostile repo and pushing from it runs its code as you. That is the same trust
# level as a Makefile or a package.json script, and acceptable for repos you
# own - but it is why no-mistakes reads its equivalent config only from the
# trusted default branch. If turnstile ever gates a repo that takes outside
# contributions, that is the fix, not a sandbox.
run_checks() {
  local label="${1:-turnstile}"
  TURNSTILE_UNRUNNABLE=0
  local -a names=() scopes=() tiers=() cmds=()
  local name scope tier cmd

  while IFS=$'\x1f' read -r name scope tier cmd; do
    names+=("$name"); scopes+=("$scope"); tiers+=("$tier"); cmds+=("$cmd")
  done < <(read_checks)

  local ai_count=0
  ai_count="$(read_ai_checks | grep -c . || true)"

  if [ "${#names[@]}" -eq 0 ] && [ "$ai_count" -eq 0 ]; then
    dim "turnstile: no $CONFIG_NAME checks in $(repo_root) - passing through"
    return 0
  fi

  local root; root="$(repo_root)"
  if ! SNAPSHOT="$(cd "$root" && snapshot_index)"; then
    say "  ${C_RED}✗${C_RESET} could not snapshot the working tree - nothing was checked"
    return 1
  fi

  local logdir; logdir="$(mktemp -d "${TMPDIR:-/tmp}/turnstile.XXXXXX")"
  TURNSTILE_CHANGED_FILES="$(cd "$root" && changed_names)"
  TURNSTILE_DIFF_FILE="$logdir/change.diff"
  (cd "$root" && change_patch) >"$TURNSTILE_DIFF_FILE"
  export TURNSTILE_MODE TURNSTILE_REMOTE TURNSTILE_BASE TURNSTILE_RANGE TURNSTILE_CHANGED_FILES TURNSTILE_DIFF_FILE

  say ""
  say "${C_BOLD}turnstile${C_RESET} ${C_DIM}${label}${C_RESET}"
  [ -n "${TURNSTILE_RANGE:-}" ] && dim "  range ${TURNSTILE_RANGE}"

  mkdir -p "$CHECK_CACHE"
  find "$CHECK_CACHE" -type f -mtime +"$CHECK_CACHE_DAYS" -delete 2>/dev/null

  local failures=0 i rc elapsed

  # The AI modules start first and run while the deterministic checks do. They
  # are the slow half by two orders of magnitude, so paying for them serially
  # after a passing test suite would make the gate feel like it hangs.
  local ai_pid="" ai_log="$logdir/ai.log"
  if [ "$ai_count" -gt 0 ] && [ -n "${TURNSTILE_CI:-}" ]; then
    dim "  · ai modules do not run in ci"
  elif [ "$ai_count" -gt 0 ] && [ -n "${TURNSTILE_NO_AI:-}" ]; then
    dim "  · ai modules not run here (they run once, at push)"
  elif [ "$ai_count" -gt 0 ]; then
    if [ -x "$AI_RUNNER" ]; then
      TURNSTILE_HOME="$TURNSTILE_HOME" "$AI_RUNNER" \
        --range "${TURNSTILE_RANGE:-HEAD~1..HEAD}" >"$ai_log" 2>&1 </dev/null &
      ai_pid=$!
    else
      warn "turnstile: $ai_count ai module(s) configured but $AI_RUNNER is missing"
    fi
  fi

  local tree_before tree_after rewritten key fresh g git_local_env
  local -a keys=() notes=() pending=() pids=() ran=()
  git_local_env="$(git rev-parse --local-env-vars)"
  tree_before="$(cd "$root" && snapshot_tree)"

  for i in "${!names[@]}"; do
    name="${names[$i]}"; scope="${scopes[$i]}"; cmd="${cmds[$i]}"

    if [ -n "${TURNSTILE_AT_STOP:-}" ] && [ "${tiers[$i]}" = push ]; then
      notes[i]="$(printf '  %s· %s (at push)%s' "$C_DIM" "$name" "$C_RESET")"
      continue
    fi

    local -a globs=() specs=()
    read -ra globs <<<"$scope"
    for g in "${globs[@]+"${globs[@]}"}"; do specs+=(":(glob)$g"); done

    if [ "${#specs[@]}" -gt 0 ] && [ -z "$(cd "$root" && changed_names "${specs[@]}")" ]; then
      notes[i]="$(printf '  %s· %s (not touched)%s' "$C_DIM" "$name" "$C_RESET")"
      continue
    fi

    key="$(cd "$root" && check_key "$name" "$cmd" "$(content_key "${specs[@]+"${specs[@]}"}")")"
    if [ -z "${TURNSTILE_NO_CACHE:-}" ] && [ -f "$CHECK_CACHE/$key" ]; then
      notes[i]="$(printf '  %s✓%s %s %s(cached)%s' "$C_GREEN" "$C_RESET" "$name" "$C_DIM" "$C_RESET")"
      continue
    fi

    keys[i]="$key"; pending+=("$i"); ran+=("$name")
    # Checks must not inherit the hook's stdin (the ref list); one `read` in a
    # check script would otherwise hang the push. Nor git's hook environment:
    # with GIT_DIR exported, a test suite that builds a temp repo commits into
    # this one instead.
    # shellcheck disable=SC2086
    (
      start=$SECONDS
      ( cd "$root" && unset $git_local_env && eval "$cmd" ) >"$logdir/$i.log" 2>&1 </dev/null
      printf '%s %s\n' "$?" "$((SECONDS - start))" >"$logdir/$i.status"
    ) &
    pids+=($!)
  done

  if [ "${#pids[@]}" -gt 0 ]; then
    [ -n "$CLEAR_LINE" ] && printf '  %s… %s%s' "$C_DIM" "${ran[*]}" "$C_RESET" >&2
    wait "${pids[@]}"
    printf '%s' "$CLEAR_LINE" >&2
  fi

  # A check that rewrites the tree (a formatter in fix mode, say) passed
  # against files that no longer exist, so its pass describes nothing. Checks
  # run concurrently, so the rewrite is pinned on the batch, not on one check.
  rewritten=""
  if [ "${#pending[@]}" -gt 0 ] && fresh="$(cd "$root" && snapshot_index)"; then
    rm -f "$SNAPSHOT"; SNAPSHOT="$fresh"
    tree_after="$(cd "$root" && snapshot_tree)"
    [ "$tree_after" != "$tree_before" ] \
      && rewritten="$(git -C "$root" -c core.quotePath=false diff-tree -r --name-only "$tree_before" "$tree_after")"
  fi

  local -a summary=()
  local summarised
  for i in "${!names[@]}"; do
    [ -f "$logdir/$i.status" ] || continue
    read -r rc elapsed <"$logdir/$i.status"
    [ "$rc" -eq 0 ] || [ "$rc" -eq "$SKIP_STATUS" ] && continue
    summarised="$(last_line "$logdir/$i.log")"
    summary+=("${names[$i]}: exit $rc${summarised:+, $summarised}")
  done
  [ -n "$rewritten" ] && summary+=("tree: modified while ${ran[*]} ran ($(printf '%s' "$rewritten" | tr '\n' ' ' | cut -c1-120))")
  if [ "${#summary[@]}" -gt 0 ]; then
    say "  ${C_RED}${C_BOLD}failing${C_RESET}"
    printf '    %s\n' "${summary[@]}" >&2
    say ""
    [ -n "${TURNSTILE_SUMMARY_FILE:-}" ] && printf '%s\n' "${summary[@]}" >"$TURNSTILE_SUMMARY_FILE"
  fi

  for i in "${!names[@]}"; do
    if [ -n "${notes[i]:-}" ]; then printf '%s\n' "${notes[i]}" >&2; continue; fi
    [ -f "$logdir/$i.status" ] || continue
    name="${names[$i]}"; cmd="${cmds[$i]}"
    read -r rc elapsed <"$logdir/$i.status"
    if [ "$rc" -eq 0 ]; then
      printf '  %s✓%s %s %s(%ss)%s\n' "$C_GREEN" "$C_RESET" "$name" "$C_DIM" "$elapsed" "$C_RESET" >&2
      [ -z "$rewritten" ] && [ -z "${TURNSTILE_CI:-}" ] && : >"$CHECK_CACHE/${keys[i]}"
      continue
    fi
    if [ "$rc" -eq "$SKIP_STATUS" ]; then
      TURNSTILE_UNRUNNABLE=$((TURNSTILE_UNRUNNABLE + 1))
      printf '  %s?%s %s %s(could not run: %s)%s\n' "$C_YELLOW" "$C_RESET" "$name" "$C_DIM" "$(last_line "$logdir/$i.log")" "$C_RESET" >&2
      continue
    fi
    failures=$((failures + 1))
    printf '  %s✗%s %s %s(exit %s, %ss)%s\n' "$C_RED" "$C_RESET" "$name" "$C_DIM" "$rc" "$elapsed" "$C_RESET" >&2
    say ""
    dim "    \$ $cmd"
    # Tail rather than the whole log: the failure is nearly always at the end,
    # and a 5000-line test dump in a hook is how people learn to --no-verify.
    sed -e 's/^/    /' <(tail -n 40 "$logdir/$i.log") >&2
    say ""
  done

  if [ -n "$rewritten" ]; then
    failures=$((failures + 1))
    printf '  %s✗%s the working tree was modified while %s ran\n' "$C_RED" "$C_RESET" "${ran[*]}" >&2
    say ""
    say "    review these files, commit what is right, rerun:"
    sed -e 's/^/      /' <<<"$rewritten" >&2
    say ""
  fi

  if [ -n "$ai_pid" ]; then
    if kill -0 "$ai_pid" 2>/dev/null; then
      [ -n "$CLEAR_LINE" ] && printf '  %s… ai%s' "$C_DIM" "$C_RESET" >&2
    fi
    wait "$ai_pid"; rc=$?
    printf '%s' "$CLEAR_LINE" >&2
    cat "$ai_log" >&2
    # Exit 1 means findings at or above the configured block level. Anything
    # else the runner already reported as a `?` and deliberately did not block
    # on - see the fail-open note in bin/turnstile-ai.
    [ "$rc" -eq 1 ] && failures=$((failures + 1))
    # Degradation is read off the report rather than the exit code on purpose:
    # the runner has to keep returning 0 here so that a pre-commit hook does
    # not fail the commit over a network blip. But a summary that says
    # everything passed when a module reviewed nothing is a lie the gate
    # cannot afford, so the count is surfaced separately.
    TURNSTILE_AI_DEGRADED="$(grep -c '^  ? ai ' "$ai_log" || true)"
    export TURNSTILE_AI_DEGRADED
  fi

  rm -f "$SNAPSHOT"
  rm -rf "$logdir"
  return $failures
}

# ---------------------------------------------------------------- commands

# Gives the shell's cwd the checks of one pushed ref. Results travel in globals
# (GATE_*) so the same function serves the in-place run and the worktree run.
gate_ref() {
  GATE_FAILURES=0 GATE_UNRUNNABLE=0 GATE_DEGRADED=0 GATE_UNAPPROVED=
  if ! config_approved; then
    GATE_UNAPPROVED=1
    return 0
  fi
  TURNSTILE_AI_DEGRADED=0
  run_checks "$1"
  GATE_FAILURES=$?
  GATE_UNRUNNABLE=$TURNSTILE_UNRUNNABLE
  GATE_DEGRADED=${TURNSTILE_AI_DEGRADED:-0}
}

PUSH_WORKTREE=""

cleanup_push_worktree() {
  [ -n "$PUSH_WORKTREE" ] || return 0
  git worktree remove --force "$PUSH_WORKTREE" >/dev/null 2>&1
  rm -rf "$PUSH_WORKTREE" "$PUSH_WORKTREE.result"
  git worktree prune >/dev/null 2>&1
  PUSH_WORKTREE=""
}

# The checks run on exactly the commit being pushed, not on whatever the working
# tree happens to hold. Hooks are off for the checkout: post-checkout would run
# the repo's own hook in a directory it knows nothing about.
gate_in_worktree() {
  local sha="$1" label="$2" git_local_env
  git_local_env="$(git rev-parse --local-env-vars)"
  PUSH_WORKTREE="$(mktemp -d "${TMPDIR:-/tmp}/turnstile-push.XXXXXX")" || return 1
  if ! git -c core.hooksPath=/dev/null worktree add -q --detach "$PUSH_WORKTREE" "$sha" >/dev/null 2>&1; then
    GATE_FAILURES=1 GATE_UNRUNNABLE=0 GATE_DEGRADED=0 GATE_UNAPPROVED=
    say "  ${C_RED}✗${C_RESET} could not check out ${sha:0:7} to verify it"
    cleanup_push_worktree
    return 0
  fi
  # shellcheck disable=SC2086
  (
    unset $git_local_env
    cd "$PUSH_WORKTREE" || exit 70
    gate_ref "$label"
    printf 'GATE_FAILURES=%s GATE_UNRUNNABLE=%s GATE_DEGRADED=%s GATE_UNAPPROVED=%s\n' \
      "$GATE_FAILURES" "$GATE_UNRUNNABLE" "$GATE_DEGRADED" "$GATE_UNAPPROVED" >"$PUSH_WORKTREE.result"
  )
  # shellcheck disable=SC1090
  if [ -f "$PUSH_WORKTREE.result" ]; then . "$PUSH_WORKTREE.result"; else GATE_FAILURES=1; fi
  cleanup_push_worktree
}

# The working tree as one hash, untracked files included.
working_tree() {
  local snap; snap="$(snapshot_index)" || return 1
  GIT_INDEX_FILE="$snap" git write-tree
  rm -f "$snap"
}

cmd_pre_push() {
  if [ -n "${TURNSTILE_SKIP:-}" ]; then
    warn "turnstile: skipped via TURNSTILE_SKIP"
    return 0
  fi

  local -a ranges=() refs=() shas=()
  local range ref lsha rsha
  while IFS=$'\t' read -r range ref lsha rsha; do
    ranges+=("$range"); refs+=("$ref"); shas+=("$lsha")
  done < <(compute_ranges)

  if [ "${#ranges[@]}" -eq 0 ]; then
    dim "turnstile: nothing to validate (deletion or empty push)"
    return 0
  fi

  trap cleanup_push_worktree EXIT INT TERM
  local root; root="$(repo_root)" || die "not inside a git repository"

  # Every pushed ref is gated, in its own pass. Rare enough that the repeated
  # deterministic checks do not matter, and the AI cache means an identical
  # diff across two refs is not paid for twice.
  local failures=0 i degraded=0 unrunnable=0 unapproved=0 warned_missing=0 default
  for i in "${!ranges[@]}"; do
    TURNSTILE_MODE=push
    [ -n "${1:-}" ] && TURNSTILE_REMOTE="$1"
    TURNSTILE_RANGE="${ranges[$i]}"
    TURNSTILE_BASE="$(git rev-parse "${TURNSTILE_RANGE%%..*}")"

    local label="pre-push → ${1:-remote}"
    [ "${#ranges[@]}" -gt 1 ] && label="$label  [${refs[$i]}]"

    local in_place=1
    if [ ! -f "$root/$CONFIG_NAME" ] && ! git cat-file -e "${shas[$i]}:$CONFIG_NAME" 2>/dev/null; then
      if [ "$warned_missing" -eq 0 ] && default="$(default_branch_ref "${1:-origin}")" \
          && git cat-file -e "$default:$CONFIG_NAME" 2>/dev/null; then
        warn "turnstile: $default tracks a $CONFIG_NAME this push does not carry - its checks did not run"
        warned_missing=1
      fi
      gate_ref "$label"
    elif [ "$(cd "$root" && working_tree)" != "$(git rev-parse "${shas[$i]}^{tree}" 2>/dev/null)" ]; then
      in_place=0
      label="$label  (${shas[$i]:0:7} in a temporary worktree)"
      gate_in_worktree "${shas[$i]}" "$label"
    else
      gate_ref "$label"
    fi

    failures=$((failures + GATE_FAILURES))
    degraded=$((degraded + GATE_DEGRADED))
    [ -n "$GATE_UNAPPROVED" ] && unapproved=1
    if [ "$in_place" -eq 0 ] && [ "$GATE_UNRUNNABLE" -gt 0 ]; then
      warn "turnstile: could not verify ${shas[$i]:0:7}: $GATE_UNRUNNABLE check(s) could not run in a clean checkout of it"
    else
      unrunnable=$((unrunnable + GATE_UNRUNNABLE))
    fi
  done

  if [ "$unapproved" -eq 1 ]; then
    say "$UNAPPROVED_MESSAGE"
    return 1
  fi

  if [ "$unrunnable" -gt 0 ] && [ "$failures" -eq 0 ]; then
    warn "turnstile: $unrunnable check(s) could not run - this push was NOT verified by them"
  fi

  if [ "$degraded" -gt 0 ] && [ "$failures" -eq 0 ]; then
    warn "turnstile: $degraded ai module(s) could not run - this push was NOT reviewed by them"
  fi

  if [ "$failures" -gt 0 ]; then
    say ""
    say "${C_RED}${C_BOLD}push refused${C_RESET} - $failures check(s) failed"
    dim "  fix them, or bypass deliberately:  git push --no-verify"
    say ""
    return 1
  fi

  say ""
  return 0
}

# The entry for hook managers: husky, lefthook or a hand-written hook call it
# with git's pre-push arguments and stdin. A global dispatcher that already
# gated this push says so through the environment.
cmd_pre_push_public() {
  if [ -n "${TURNSTILE_IN_pre_push:-}" ]; then
    dim "turnstile: already gated by the global dispatcher"
    return 0
  fi
  cmd_pre_push "$@"
}

worktree_base() {
  local base
  if ! base="$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)"; then
    base="$(default_base HEAD)"
  fi
  git merge-base "$base" HEAD 2>/dev/null || git rev-parse "$base"
}

cmd_run() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-ai)    TURNSTILE_NO_AI=1 ;;
      --no-cache) TURNSTILE_NO_CACHE=1 ;;
      --stop)     TURNSTILE_NO_AI=1 TURNSTILE_AT_STOP=1 ;;
      -h|--help)  usage; return 0 ;;
      *)          die "unknown option for run: $1" ;;
    esac
    shift
  done

  local root; root="$(repo_root)" || die "not inside a git repository"

  if ! config_approved; then
    say "$UNAPPROVED_MESSAGE"
    return 1
  fi

  # The same base a push would use, so a tree that passes here is a cache hit
  # there. The working tree is what gets checked, committed or not.
  TURNSTILE_MODE=worktree
  TURNSTILE_BASE="$(worktree_base)"
  TURNSTILE_RANGE="${TURNSTILE_BASE}..HEAD"

  local label="manual run"
  [ -n "${TURNSTILE_AT_STOP:-}" ] && label="agent stop"
  run_checks "$label"
  verdict $? "this push would be refused"
}

# Prints the closing line of a run and returns its status.
verdict() {
  local failures="$1" consequence="$2"
  say ""
  if [ "$failures" -gt 0 ]; then
    say "  ${C_RED}${C_BOLD}$failures check(s) failed${C_RESET} - $consequence"
    say ""
    return 1
  fi
  local unran=""
  [ "$TURNSTILE_UNRUNNABLE" -gt 0 ] && unran="$TURNSTILE_UNRUNNABLE check(s)"
  if [ "${TURNSTILE_AI_DEGRADED:-0}" -gt 0 ]; then
    unran="${unran:+$unran, }${TURNSTILE_AI_DEGRADED} ai module(s)"
  fi
  if [ -n "$unran" ]; then
    say "  ${C_GREEN}${C_BOLD}all checks passed${C_RESET} ${C_YELLOW}($unran could not run)${C_RESET}"
  else
    say "  ${C_GREEN}${C_BOLD}all checks passed${C_RESET}"
  fi
  say ""
  return 0
}

# Deterministic checks only, no pass cache, and the check list comes from the
# base ref: a change cannot weaken the gate that judges it. What the listed
# commands do still comes from the checked-out tree.
cmd_ci() {
  local base=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --base)   base="${2:-}"; shift ;;
      --base=*) base="${1#--base=}" ;;
      -h|--help) usage; return 0 ;;
      *)        die "unknown option for ci: $1" ;;
    esac
    shift
  done
  [ -n "$base" ] || die "ci needs --base <ref>"
  local root sha; root="$(repo_root)" || die "not inside a git repository"
  sha="$(git rev-parse --verify --quiet "$base^{commit}")" || die "unknown base: $base"

  if ! git cat-file -e "$sha:$CONFIG_NAME" 2>/dev/null; then
    dim "turnstile ci: no $CONFIG_NAME at $base - nothing to run"
    return 0
  fi
  CONFIG_OVERRIDE="$(mktemp "${TMPDIR:-/tmp}/turnstile-config.XXXXXX")"
  git show "$sha:$CONFIG_NAME" >"$CONFIG_OVERRIDE"

  TURNSTILE_NO_AI=1 TURNSTILE_NO_CACHE=1 TURNSTILE_CI=1
  TURNSTILE_MODE=push
  TURNSTILE_BASE="$(git merge-base "$sha" HEAD 2>/dev/null || printf '%s' "$sha")"
  TURNSTILE_RANGE="${TURNSTILE_BASE}..HEAD"
  run_checks "ci (checks from $base)"
  local failures=$?
  rm -f "$CONFIG_OVERRIDE"
  verdict "$failures" "this change fails the checks of $base"
}

# ---------------------------------------------------------------- push scope

# A range diff bills a push for merged-in default-branch commits, so the scope is measured per pushed commit.

SCOPE_MODE="" SCOPE_BASE="" SCOPE_TIP="" REMERGE_OK=""

scope_fail() { printf '%sx %s%s\n' "$C_RED" "$*" "$C_RESET" >&2; exit 2; }

require_perl() {
  command -v perl >/dev/null 2>&1 || scope_fail "perl is not on PATH, which turnstile files and the diff scan need"
}

require_python3() {
  command -v python3 >/dev/null 2>&1 || scope_fail "python3 is not on PATH, which scan added --kaibo-checks needs"
}

# The missing-config warning needs the remote's own default branch, so the local fallback lives here.
scope_default_ref() {
  local ref
  default_branch_ref "${TURNSTILE_REMOTE:-origin}" && return 0
  for ref in main master; do
    if git rev-parse --verify --quiet "refs/heads/$ref" >/dev/null 2>&1; then printf '%s' "$ref"; return 0; fi
  done
  return 1
}

is_commit() { git rev-parse --verify --quiet "$1^{commit}" >/dev/null 2>&1; }

scope_resolve() {
  if [ -n "${TURNSTILE_MODE:-}" ]; then SCOPE_MODE="$TURNSTILE_MODE"
  elif [ -n "${TURNSTILE_RANGE:-}" ]; then SCOPE_MODE=push
  else SCOPE_MODE=worktree
  fi

  if [ -n "${TURNSTILE_RANGE:-}" ]; then
    case "$TURNSTILE_RANGE" in
      *...*)
        SCOPE_BASE="${TURNSTILE_RANGE%%...*}"
        SCOPE_TIP="${TURNSTILE_RANGE##*...}"
        [ -n "$SCOPE_BASE" ] || SCOPE_BASE=HEAD
        [ -n "$SCOPE_TIP" ] || SCOPE_TIP=HEAD
        SCOPE_BASE="$(git merge-base "$SCOPE_BASE" "$SCOPE_TIP")" \
          || scope_fail "no merge base for TURNSTILE_RANGE $TURNSTILE_RANGE"
        ;;
      *..*)
        SCOPE_BASE="${TURNSTILE_RANGE%%..*}"
        SCOPE_TIP="${TURNSTILE_RANGE##*..}"
        [ -n "$SCOPE_TIP" ] || SCOPE_TIP=HEAD
        ;;
      *) scope_fail "TURNSTILE_RANGE is not a range: $TURNSTILE_RANGE" ;;
    esac
  else
    SCOPE_BASE="$(worktree_base)" || scope_fail "could not resolve the base of the change"
    SCOPE_TIP=HEAD
  fi

  SCOPE_TIP="$(git rev-parse --verify --quiet "$SCOPE_TIP^{commit}")" \
    || scope_fail "unknown revision in the push scope: ${SCOPE_TIP}"

  local resolved fork default
  if resolved="$(git rev-parse --verify --quiet "$SCOPE_BASE^{commit}")"; then
    SCOPE_BASE="$resolved"
  elif resolved="$(git rev-parse --verify --quiet "$SCOPE_BASE^{tree}")"; then
    SCOPE_BASE="$resolved"
    if default="$(scope_default_ref)" \
        && fork="$(git merge-base "$default" "$SCOPE_TIP" 2>/dev/null)"; then
      SCOPE_BASE="$fork"
    fi
  else
    scope_fail "unknown base in the push scope: $SCOPE_BASE"
  fi

  probe_remerge
}

# Probed up front: a lazily set cache would die with the pipeline subshell that set it.
probe_remerge() {
  REMERGE_OK=0
  [ -z "${TURNSTILE_FORCE_CC:-}" ] || return 0
  if git log -n0 --remerge-diff --format= --all >/dev/null 2>&1; then REMERGE_OK=1; fi
}

# Fails closed: a scan that saw no commits would read as clean. Prints "<sha> <parent count>" per commit.
pushed_commits() {
  local -a excludes=()
  local default listing
  if default="$(scope_default_ref)"; then excludes+=("^$default"); fi
  if is_commit "$SCOPE_BASE"; then excludes+=("^$SCOPE_BASE"); fi
  listing="$(git rev-list --parents "$SCOPE_TIP" ${excludes[@]+"${excludes[@]}"})" \
    || scope_fail "could not enumerate pushed commits"
  printf '%s\n' "$listing" | awk 'NF { print $1, NF - 1 }'
}

SCAN_DIFF_OPTS=(--no-color --no-ext-diff --no-textconv --src-prefix=a/ --dst-prefix=b/)

# A merge is diffed against a re-merge of its parents so the commits it brings in are not billed to it.
commit_scan_diff() {
  local sha="$1" parents="$2" mode=--cc
  if [ "$parents" -gt 1 ]; then
    [ "$REMERGE_OK" = 1 ] && mode=--remerge-diff
    git -c core.quotePath=false show "$mode" --format= --no-show-signature "${SCAN_DIFF_OPTS[@]}" "$sha"
  else
    git -c core.quotePath=false show --format= --no-show-signature -U0 "${SCAN_DIFF_OPTS[@]}" "$sha"
  fi
}

# Reports "id: path:line", never the line, so a secret that trips it is not copied into logs.
IFS= read -r -d '' SCAN_MATCH_PERL <<'PERL' || true
use strict;
use warnings;

my @patterns;
for my $record (split /\x1e/, $ENV{TS_PATTERNS} // '') {
    next if $record eq '';
    my ($id, $source) = split /\x1f/, $record, 2;
    my $regex;
    utf8::decode($source) if defined $source;
    $regex = eval { qr/$source/ } if defined $source && length $source;
    if (!$regex) {
        print STDERR "bad pattern $id\n";
        exit 2;
    }
    push @patterns, [$id, $regex];
}

my $context = $ENV{TS_CONTEXT} // '';
my $found = 0;

sub report {
    my ($path, $line_no, $text) = @_;
    utf8::decode($text);
    for my $pattern (@patterns) {
        my ($id, $regex) = @$pattern;
        next unless $text =~ $regex;
        print "  x $id: $path:$line_no ($context)\n";
        $found = 1;
    }
}

sub unescape {
    my ($quoted) = @_;
    my %escape = (t => "\t", n => "\n", '"' => '"', '\\' => '\\');
    $quoted =~ s{\\(?:([0-7]{3})|(.))}{defined $1 ? chr(oct $1) : ($escape{$2} // $2)}gse;
    return $quoted;
}

sub unquote_path {
    my ($path) = @_;
    $path =~ s/\t.*\z//s;
    return $path unless $path =~ /\A"(.*)"\z/s;
    return unescape($1);
}

sub new_path {
    my $path = unquote_path($_[0]);
    return undef if $path eq '/dev/null';
    $path =~ s{\Ab/}{};
    return $path;
}

sub git_header_path {
    my ($names) = @_;
    return unescape($1) if $names =~ m{ "b/((?:[^"\\]|\\.)*)"\z}s;
    return $1 if $names =~ m{\A"a/(?:[^"\\]|\\.)*" b/(.+)\z}s;
    return $1 if $names =~ m{\Aa/(.+) b/(.+)\z}s && $1 eq $2;
    return undef;
}

if ($ENV{TS_PLAIN}) {
    my $path = $ENV{TS_PATH} // '';
    exit 0 if ((stat STDIN)[7] // 0) > 10 * 1024 * 1024;
    my $head = '';
    read(STDIN, $head, 8192);
    exit 0 if $head =~ /\0/;
    my $data = $head . (do { local $/; <STDIN> } // '');
    open(my $fh, '<', \$data) or exit 2;
    while (my $line = <$fh>) {
        chomp $line;
        $line =~ s/\r\z//;
        report($path, $., $line);
    }
    exit $found;
}

my ($file, $line_no, $columns, $in_hunk, $old_left, $new_left) = (undef, 0, 0, 0, 0, 0);

while (my $line = <STDIN>) {
    chomp $line;
    $line =~ s/\r\z//;

    if ($line =~ /\Aturnstile-commit: (\S+)\z/) {
        $context = substr($1, 0, 7);
        ($file, $in_hunk) = (undef, 0);
        next;
    }

    if ($line =~ /\A(@@+) (.*?) \1/) {
        my ($marks, $ranges) = ($1, $2);
        $columns = length($marks) - 1;
        my ($new_start, $new_count) = $ranges =~ /\+(\d+)(?:,(\d+))?/;
        my ($old_count) = $ranges =~ /-\d+(?:,(\d+))?/;
        ($line_no, $new_left, $old_left) = ($new_start, $new_count // 1, $old_count // 1);
        $in_hunk = 1;
        next;
    }

    if ($in_hunk && $line !~ /\Adiff /) {
        next if $line =~ /\A\\/;
        my $where = $file // '(unknown)';
        if ($columns == 1) {
            my $tag = substr($line, 0, 1);
            if ($tag eq '+') {
                report($where, $line_no, substr($line, 1));
                $line_no++;
                $new_left--;
            } elsif ($tag eq ' ' || $tag eq '') {
                $line_no++;
                $old_left--;
                $new_left--;
            } elsif ($tag eq '-') {
                $old_left--;
            }
            $in_hunk = 0 if $old_left <= 0 && $new_left <= 0;
        } elsif (length($line) >= $columns) {
            my $tags = substr($line, 0, $columns);
            report($where, $line_no, substr($line, $columns)) unless $tags =~ /[^+]/;
            $line_no++ unless $tags =~ /-/;
        }
        next;
    }
    $in_hunk = 0;

    if ($line =~ /\Adiff --(?:cc|combined) (.+)\z/) {
        $file = unquote_path($1);
    } elsif ($line =~ /\Adiff --git (.+)\z/) {
        $file = git_header_path($1);
    } elsif ($line =~ /\Adiff /) {
        $file = undef;
    } elsif ($line =~ /\A\+\+\+ (.*)\z/) {
        $file = new_path($1);
    } elsif ($line =~ /\A(?:rename|copy) to (.*)\z/) {
        $file = unquote_path($1);
    }
}

exit $found;
PERL
readonly SCAN_MATCH_PERL

scan_match() {
  require_perl
  perl -e "$SCAN_MATCH_PERL"
}

# Runs the producer into the matcher. 0 clean, 1 findings, 2 cannot scan: the matcher's own verdict
# stands unless the producer failed, and a matcher that quit early (bad pattern) outranks the SIGPIPE it caused.
scan_through() {
  local -a status
  "$@" | scan_match
  status=("${PIPESTATUS[@]}")
  [ "${status[1]}" -ne 2 ] && [ "${status[0]}" -eq 0 ] || return 2
  return "${status[1]}"
}

SECRET_PATTERNS=(
  'private-key:-----BEGIN (?:[A-Z]+ )?PRIVATE KEY-----'
  'aws-access-key:\bAKIA[0-9A-Z]{16}\b'
  'github-token:\b(?:gh[pousr]_|github_pat_)[A-Za-z0-9_]{20,}'
  'gitlab-pat:\bglpat-[A-Za-z0-9_-]{20,}'
  'atlassian-token:\bATATT[A-Za-z0-9_\-=]{20,}'
  'slack-token:\bxox[abprs]-[A-Za-z0-9-]{10,}'
  'generic-sk-key:(?<!\w)sk-[A-Za-z0-9_-]{16,}'
)
readonly SECRET_PATTERNS

# A push leaves the machine as committed, so only a worktree run has these.
scan_worktree_extras() {
  [ "$SCOPE_MODE" = worktree ] || return 0
  local rc=0 path list

  TS_CONTEXT=uncommitted scan_through git -c core.quotePath=false diff -U0 "${SCAN_DIFF_OPTS[@]}" HEAD
  rc=$?
  [ "$rc" -lt 2 ] || return 2

  list="$(mktemp "${TMPDIR:-/tmp}/turnstile-untracked.XXXXXX")" || return 2
  if ! git -c core.quotePath=false ls-files --others --exclude-standard -z >"$list"; then
    rm -f "$list"
    return 2
  fi
  while IFS= read -r -d '' path; do
    [ -f "$path" ] && [ ! -L "$path" ] || continue
    TS_PLAIN=1 TS_PATH="$path" TS_CONTEXT=untracked scan_match <"$path"
    case $? in 0) ;; 1) rc=1 ;; *) rc=2; break ;; esac
  done <"$list"
  rm -f "$list"
  return $rc
}

# A merge counts only for what it changed against a re-merge of its parents.
commit_paths() {
  local filter="$1" sha="$2" parents="$3"
  shift 3
  local -a merge=()
  if [ "$parents" -gt 1 ]; then
    if [ "$REMERGE_OK" = 1 ]; then merge=(--remerge-diff); else merge=(-c); fi
  fi
  git -c core.quotePath=false diff-tree -r -M -z --root --name-only --diff-filter="$filter" --format= \
    ${merge[@]+"${merge[@]}"} "$sha" -- "$@"
}

files_collect() {
  local sha parents commits
  commits="$(pushed_commits)" || return 2
  while read -r sha parents; do
    [ -n "$sha" ] || continue
    commit_paths d "$sha" "$parents" "$@" || return 2
  done <<<"$commits"

  [ "$SCOPE_MODE" = worktree ] || return 0
  git -c core.quotePath=false diff --name-only -z --diff-filter=d HEAD -- "$@" || return 2
  git -c core.quotePath=false ls-files --others --exclude-standard -z -- "$@" || return 2
}

# A file the push added and later deleted must not be listed.
files_existing() {
  local terminator="$1" path
  perl -0ne 'print unless $seen{$_}++' | while IFS= read -r -d '' path; do
    if [ "$SCOPE_MODE" = worktree ]; then
      [ -e "$path" ] || [ -L "$path" ] || continue
    else
      git cat-file -e "$SCOPE_TIP:$path" 2>/dev/null </dev/null || continue
    fi
    printf "%s$terminator" "$path"
  done
}

cmd_files() {
  require_perl
  local terminator='\n' g raw rc
  local -a globs=() specs=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --glob)    [ -n "${2:-}" ] || die "files needs a pattern after --glob"; globs+=("$2"); shift ;;
      --glob=*)  globs+=("${1#--glob=}") ;;
      -0)        terminator='\0' ;;
      -h|--help) usage; return 0 ;;
      *)         die "unknown option for files: $1" ;;
    esac
    shift
  done
  local root; root="$(repo_root)" || die "not inside a git repository"
  cd "$root" || exit 2
  scope_resolve
  for g in "${globs[@]+"${globs[@]}"}"; do specs+=(":(glob)$g"); done

  raw="$(mktemp "${TMPDIR:-/tmp}/turnstile-files.XXXXXX")" || exit 2
  if ! files_collect "${specs[@]+"${specs[@]}"}" >"$raw"; then
    rm -f "$raw"
    exit 2
  fi
  files_existing "$terminator" <"$raw"
  rc=$?
  rm -f "$raw"
  [ "$rc" -eq 0 ] || exit 2
}

# One matcher reads every commit's diff, each introduced by a separator line that carries its sha.
commit_diff_stream() {
  local sha parents
  while read -r sha parents; do
    [ -n "$sha" ] || continue
    printf 'turnstile-commit: %s\n' "$sha"
    commit_scan_diff "$sha" "$parents" || return 1
  done <<<"$1"
}

# Prints the findings; returns 0 clean, 1 findings, 2 cannot scan.
scan_added_run() {
  local since_base="$1" rc=0 extras commits base default

  if [ -n "$since_base" ]; then
    default="$(scope_default_ref)" \
      || scope_fail "--since-base needs a default branch ref (origin/main, origin/master, main or master)"
    base="$(git merge-base "$default" "$SCOPE_TIP")" || scope_fail "no merge base of $default and the push tip"
    TS_CONTEXT=since-base scan_through git -c core.quotePath=false diff -U0 "${SCAN_DIFF_OPTS[@]}" "$base" "$SCOPE_TIP"
  else
    commits="$(pushed_commits)" || return 2
    scan_through commit_diff_stream "$commits"
  fi
  rc=$?
  [ "$rc" -lt 2 ] || return 2

  scan_worktree_extras
  extras=$?
  [ "$extras" -lt 2 ] || return 2
  [ "$extras" -le "$rc" ] || rc=$extras
  return $rc
}

scan_claim_id() {
  case "$claimed" in *"|$1|"*) scope_fail "scan added: duplicate pattern id: $1${2:+ (from kaibo page $2)}" ;; esac
  claimed="$claimed$1|"
}

# Fails closed: a page that binds but cannot be read must stop the scan, never shrink it.
kaibo_forbid_patterns() {
  local root="${TURNSTILE_KAIBO_KNOWLEDGE:-${HOME:-}/.kaibo/knowledge}"
  [ -d "$root" ] \
    || scope_fail "scan added: no kaibo knowledge corpus at $root; set TURNSTILE_KAIBO_KNOWLEDGE or run kaibo sync"
  python3 - "$root" <<'PY'
import json
import os
import re
import sys

FENCE = "```json kaibo-checks"
BINDING = re.compile(r"""^binding\s*:\s*(?:"([^"]*)"|'([^']*)'|([^#\s]*))\s*(?:#.*)?$""")


def fail(page, why):
    sys.stderr.write(f"x scan added: {page}: {why}\n")
    sys.exit(2)


def binding(page, lines):
    """Reads the frontmatter off the line iterator; the body is left unread."""
    if next(lines, "").strip() != "---":
        return False
    result = False
    for line in lines:
        if line.strip() == "---":
            return result
        match = BINDING.match(line.rstrip())
        if not match:
            continue
        value = next(g for g in match.groups() if g is not None).strip().lower()
        if value not in ("true", "false"):
            fail(page, f"unrecognised binding value {value!r}")
        result = value == "true"
    return False


def blocks(page, lines):
    body = None
    for line in lines:
        if body is None:
            if line.strip() == FENCE:
                body = []
        elif line.strip() == "```":
            yield "\n".join(body)
            body = None
        else:
            body.append(line)
    if body is not None:
        fail(page, "unterminated kaibo-checks block")


root = sys.argv[1]
out = []
owner = {}
for dirpath, dirnames, filenames in os.walk(root):
    dirnames[:] = sorted(d for d in dirnames if not d.startswith("."))
    for name in sorted(filenames):
        if not name.endswith(".md"):
            continue
        page = os.path.join(dirpath, name)
        with open(page, encoding="utf-8-sig", errors="replace") as fh:
            lines = (line.rstrip("\r\n") for line in fh)
            if not binding(page, lines):
                continue
            for text in blocks(page, lines):
                try:
                    checks = json.loads(text)
                except ValueError as err:
                    fail(page, f"malformed kaibo-checks JSON ({err})")
                if not isinstance(checks, list):
                    fail(page, "kaibo-checks is not a JSON array")
                for check in checks:
                    if not isinstance(check, dict):
                        fail(page, "kaibo-checks entry is not an object")
                    if check.get("kind") != "forbid_regex":
                        continue
                    cid, pattern = check.get("id"), check.get("pattern")
                    if not (isinstance(cid, str) and cid and isinstance(pattern, str) and pattern):
                        fail(page, "forbid_regex check needs a non-empty id and pattern")
                    if cid in owner:
                        fail(page, f"duplicate pattern id {cid} (also in {owner[cid]})")
                    owner[cid] = page
                    out.append(f"{cid}\x1f{pattern}\x1f{page}\x1e")
if not out:
    fail(root, "no kaibo checks found (no binding page carries a forbid_regex check); run kaibo sync")
sys.stdout.buffer.write("".join(out).encode("utf-8"))
PY
}

cmd_scan_added() {
  require_perl
  local since_base="" secrets="" kaibo="" id records="" entry i claimed="|" kaibo_records record page
  local -a ids=() sources=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --forbid)
        [ -n "${2:-}" ] || scope_fail "scan added needs a pattern after --forbid"
        sources+=("$2"); ids+=(""); shift ;;
      --forbid=*)
        [ -n "${1#--forbid=}" ] || scope_fail "scan added needs a pattern after --forbid"
        sources+=("${1#--forbid=}"); ids+=("") ;;
      --id|--id=*)
        if [ "$1" = --id ]; then id="${2:-}"; shift; else id="${1#--id=}"; fi
        [ -n "$id" ] || scope_fail "scan added needs a name after --id"
        [ "${#ids[@]}" -gt 0 ] || scope_fail "scan added: --id names the --forbid before it"
        ids[${#ids[@]}-1]="$id" ;;
      --forbid-secrets) secrets=1 ;;
      --kaibo-checks)   kaibo=1 ;;
      --since-base)     since_base=1 ;;
      -h|--help)        usage; return 0 ;;
      *)                scope_fail "unknown option for scan added: $1" ;;
    esac
    shift
  done
  [ "${#sources[@]}" -gt 0 ] || [ -n "$secrets" ] || [ -n "$kaibo" ] \
    || scope_fail "scan added needs a pattern source: --forbid REGEX, --forbid-secrets or --kaibo-checks"

  for ((i = 0; i < ${#sources[@]}; i++)); do
    id="${ids[$i]}"
    [ -n "$id" ] || { [ "$i" -eq 0 ] && id=forbid || id="forbid$((i + 1))"; }
    scan_claim_id "$id"
    records="$records$id"$'\037'"${sources[$i]}"$'\036'
  done
  if [ -n "$secrets" ]; then
    for entry in "${SECRET_PATTERNS[@]}"; do
      scan_claim_id "${entry%%:*}"
      records="$records${entry%%:*}"$'\037'"${entry#*:}"$'\036'
    done
  fi
  if [ -n "$kaibo" ]; then
    require_python3
    kaibo_records="$(kaibo_forbid_patterns)" || exit 2
    while IFS= read -r -d $'\036' record; do
      page="${record##*$'\037'}"
      record="${record%$'\037'*}"
      scan_claim_id "${record%%$'\037'*}" "$page"
      records="$records$record"$'\036'
    done <<<"$kaibo_records"
  fi
  export TS_PATTERNS="$records"

  local root; root="$(repo_root)" || scope_fail "not inside a git repository"
  cd "$root" || exit 2
  scope_resolve

  local found rc
  found="$(scan_added_run "$since_base")"
  rc=$?
  [ -z "$found" ] || printf '%s\n' "$found"
  case $rc in
    0) return 0 ;;
    1) printf 'scan: %s forbidden line(s) added\n' "$(printf '%s\n' "$found" | grep -c '^  x ')"; return 1 ;;
    *) exit 2 ;;
  esac
}

# One context per commit, announced by an empty record since no path is empty, then that commit's paths.
paths_added_collect() {
  local sha parents commits
  commits="$(pushed_commits)" || return 2
  while read -r sha parents; do
    [ -n "$sha" ] || continue
    printf '\0%s\0' "${sha:0:7}"
    commit_paths AR "$sha" "$parents" || return 2
  done <<<"$commits"

  [ "$SCOPE_MODE" = worktree ] || return 0
  printf '\0uncommitted\0'
  git -c core.quotePath=false diff -M --name-only -z --diff-filter=AR HEAD || return 2
}

# "paths" lists each added path once for check-ignore. "report" names the ones its verdict says a tracked .gitignore
# ignores and ends with the count, which only perl can take since a path may hold a newline. --no-index judges
# paths the push may have untracked since. A source counts only when it is a .gitignore the tip tracks (the index
# too in a worktree run), so .git/info/exclude, global excludes and a personal relative excludesFile stay personal.
IFS= read -r -d '' PATHS_PERL <<'PERL' || true
use strict;
use warnings;
local $/;
my ($mode, $added, $verdict) = @ARGV;
open(my $in, '<:raw', $added) or exit 2;
my @added = split /\0/, <$in>, -1;
pop @added;

my $expect_marker = 1;
for (my $i = 0; $i < @added; $i++) {
    if ($added[$i] eq '') {
        $i++;
        exit 2 unless defined $added[$i] && $added[$i] =~ /\A(?:[0-9a-f]{7,40}|uncommitted)\z/;
        $expect_marker = 0;
    } else {
        exit 2 if $expect_marker;
    }
}

my (%ignored, %tracked);
sub tracked_source {
    my ($source) = @_;
    return $tracked{$source} //= do {
        open(local *STDERR, '>', '/dev/null') or exit 2;
        open(local *STDOUT, '>', '/dev/null') or exit 2;
        my $found = system('git', 'cat-file', '-e', "$ENV{TS_TIP}:$source") == 0;
        $found ||= system('git', 'ls-files', '--error-unmatch', '--', $source) == 0 if $ENV{TS_WORKTREE};
        $found ? 1 : 0;
    };
}

if ($mode eq 'report') {
    open(my $v, '<:raw', $verdict) or exit 2;
    my @fields = split /\0/, <$v>;
    while (my ($source, undef, $pattern, $path) = splice @fields, 0, 4) {
        next unless defined $path && $source =~ m{\A(?:.*/)?\.gitignore\z} && $pattern !~ /\A!/;
        $ignored{$path} = 1 if $source !~ m{\A/} && tracked_source($source);
    }
}

my ($context, $count, %seen) = ('', 0);
while (@added) {
    my $path = shift @added;
    if ($path eq '') { $context = shift @added; next; }
    if ($mode eq 'paths') { print "$path\0" unless $seen{$path}++; next; }
    next unless $ignored{$path} && !$seen{"$context\0$path"}++;
    print "  x gitignored: $path ($context)\n";
    $count++;
}
print "scan: $count gitignored path(s) added\n" if $mode eq 'report' && $count;
exit($mode eq 'report' && $count ? 1 : 0);
PERL
readonly PATHS_PERL

# One unjudgeable path, such as one beyond a symlink in the checkout, must not hide the rest.
paths_judge() {
  local dir="$1" path judged=0 failed=0
  git -c core.quotePath=false check-ignore --no-index -v -z --stdin <"$dir/paths" >"$dir/verdict" 2>/dev/null
  [ $? -le 1 ] && return 0

  : >"$dir/verdict"
  while IFS= read -r -d '' path; do
    printf '%s\0' "$path" | git -c core.quotePath=false check-ignore --no-index -v -z --stdin >"$dir/one" 2>/dev/null
    if [ "${PIPESTATUS[1]}" -le 1 ]; then
      cat "$dir/one" >>"$dir/verdict"
      judged=$((judged + 1))
    else
      warn "turnstile: could not judge $path"
      failed=$((failed + 1))
    fi
  done <"$dir/paths"
  [ "$failed" -eq 0 ] || [ "$judged" -gt 0 ]
}

scan_paths_run() {
  local dir rc
  dir="$(mktemp -d "${TMPDIR:-/tmp}/turnstile-paths.XXXXXX")" || return 2
  paths_added_collect >"$dir/added" || { rm -rf "$dir"; return 2; }
  perl -e "$PATHS_PERL" paths "$dir/added" >"$dir/paths" || { rm -rf "$dir"; return 2; }
  if paths_judge "$dir"; then
    TS_TIP="$SCOPE_TIP" TS_WORKTREE="$([ "$SCOPE_MODE" = worktree ] && echo 1)" \
      perl -e "$PATHS_PERL" report "$dir/added" "$dir/verdict"
    rc=$?
  else
    rc=2
  fi
  rm -rf "$dir"
  return $rc
}

cmd_scan_paths() {
  require_perl
  local forbid_gitignored=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --forbid-gitignored) forbid_gitignored=1 ;;
      -h|--help)           usage; return 0 ;;
      *)                   scope_fail "unknown option for scan paths: $1" ;;
    esac
    shift
  done
  [ -n "$forbid_gitignored" ] || scope_fail "scan paths needs a mode: --forbid-gitignored"

  local root; root="$(repo_root)" || scope_fail "not inside a git repository"
  cd "$root" || exit 2
  scope_resolve

  local rc
  scan_paths_run
  rc=$?
  [ "$rc" -lt 2 ] || exit 2
  return $rc
}

cmd_scan() {
  case "${1:-}" in
    added)     shift; cmd_scan_added "$@" ;;
    paths)     shift; cmd_scan_paths "$@" ;;
    -h|--help) usage; return 0 ;;
    "")        scope_fail "scan needs a subcommand: added or paths" ;;
    *)         scope_fail "unknown scan subcommand: $1" ;;
  esac
}

# The working tree as one hash, untracked files included. For the Stop hook,
# which has to tell "the agent changed something" from "the agent gave up".
cmd_tree() {
  local root; root="$(repo_root)" || die "not inside a git repository"
  cd "$root" || exit 1
  working_tree || die "could not snapshot the working tree"
}

cmd_approved() {
  repo_root >/dev/null || return 0
  config_approved && return 0
  printf '%s\n' "$UNAPPROVED_MESSAGE"
  return 1
}

cmd_hook() {
  case "${1:-}" in
    claude-stop)
      exec sh "$TURNSTILE_HOME/claude/stop-hook.sh"
      ;;
    *) die "unknown hook: ${1:-}  (known: claude-stop)" ;;
  esac
}

cmd_print_claude_settings() {
  cat "$TURNSTILE_HOME/claude/settings.json"
}

REPO_HOOK_MARKER='installed by `turnstile install --repo`'

repo_hook_path() {
  local common; common="$(git rev-parse --git-common-dir 2>/dev/null)" || die "not inside a git repository"
  printf '%s/hooks/pre-push' "$common"
}

cmd_install_repo() {
  local hook; hook="$(repo_hook_path)"
  if [ -e "$hook" ] && ! grep -qF "$REPO_HOOK_MARKER" "$hook"; then
    die "$hook already exists and is not turnstile's.
    Call \`turnstile pre-push \"\$@\"\` from it, with git's stdin passed through."
  fi
  mkdir -p "$(dirname "$hook")"
  cat >"$hook" <<HOOK
#!/bin/sh
# $REPO_HOOK_MARKER
command -v turnstile >/dev/null 2>&1 || { echo "turnstile is not installed, so the pre-push checks of this repo did not run. See https://github.com/a-grasso/turnstile#install" >&2; exit 0; }
exec turnstile pre-push "\$@"
HOOK
  chmod +x "$hook"
  say "  ${C_GREEN}✓${C_RESET} wrote $hook"
  if [ -n "$(git config --get core.hooksPath || true)" ]; then
    warn "core.hooksPath is set, so git will not run $hook - call 'turnstile pre-push' from that hook manager instead"
  fi
}

cmd_uninstall_repo() {
  local hook; hook="$(repo_hook_path)"
  if [ -e "$hook" ] && grep -qF "$REPO_HOOK_MARKER" "$hook"; then
    rm -f "$hook"
    say "  ${C_GREEN}✓${C_RESET} removed $hook"
  else
    warn "$hook is not turnstile's - leaving it alone"
  fi
}

cmd_install() {
  local repo=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo)       repo=1 ;;
      -h|--help)    usage; return 0 ;;
      *)            die "unknown option for install: $1" ;;
    esac
    shift
  done
  if [ "$repo" -eq 1 ]; then cmd_install_repo; return; fi
  local dispatch="$TURNSTILE_HOME/hooks/dispatch"
  [ -x "$dispatch" ] || die "missing or non-executable: $dispatch"

  local existing
  existing="$(git config --global --get core.hooksPath || true)"
  if [ -n "$existing" ] && [ "$existing" != "$HOOKS_INSTALL_DIR" ]; then
    die "global core.hooksPath is already set to '$existing'.
    turnstile would replace it. Resolve that first (or point turnstile's
    dispatcher at it) - silently taking over another tool's hooks is exactly
    the kind of trapdoor this tool is supposed to not be."
  fi

  mkdir -p "$HOOKS_INSTALL_DIR"
  local h
  for h in "${GIT_HOOKS[@]}"; do
    ln -sf "$dispatch" "$HOOKS_INSTALL_DIR/$h"
  done

  git config --global core.hooksPath "$HOOKS_INSTALL_DIR"

  say ""
  say "  ${C_GREEN}✓${C_RESET} turnstile installed"
  say ""
  dim "    dispatcher  $dispatch"
  dim "    hooks       $HOOKS_INSTALL_DIR  (${#GIT_HOOKS[@]} symlinks)"
  dim "    git config  core.hooksPath (global)"
  say ""
  say "  Add a ${C_BOLD}.turnstile${C_RESET} file to any repo you want gated:"
  say ""
  dim "    lint: make lint"
  dim "    test: go test ./..."
  say ""
  say "  Repos without one pass straight through."
  say ""
}

cmd_uninstall() {
  local repo=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo)       repo=1 ;;
      -h|--help)    usage; return 0 ;;
      *)            die "unknown option for uninstall: $1" ;;
    esac
    shift
  done
  if [ "$repo" -eq 1 ]; then cmd_uninstall_repo; return; fi
  local current
  current="$(git config --global --get core.hooksPath || true)"
  if [ "$current" = "$HOOKS_INSTALL_DIR" ]; then
    git config --global --unset core.hooksPath
    say "  ${C_GREEN}✓${C_RESET} unset global core.hooksPath"
  else
    warn "global core.hooksPath is '$current' - leaving it alone"
  fi
  if [ -d "$HOOKS_INSTALL_DIR" ]; then
    rm -rf "$HOOKS_INSTALL_DIR"
    say "  ${C_GREEN}✓${C_RESET} removed $HOOKS_INSTALL_DIR"
  fi
}

cmd_status() {
  say ""
  say "  ${C_BOLD}turnstile${C_RESET} $TURNSTILE_VERSION"
  say ""

  local global_path repo_path root cfg
  global_path="$(git config --global --get core.hooksPath || true)"
  root="$(repo_root || true)"

  if [ "$global_path" = "$HOOKS_INSTALL_DIR" ]; then
    say "  global      ${C_GREEN}installed${C_RESET}  ($HOOKS_INSTALL_DIR)"
  elif [ -n "$global_path" ]; then
    say "  global      ${C_YELLOW}not installed${C_RESET}  (core.hooksPath = $global_path)"
  else
    say "  global      ${C_YELLOW}not installed${C_RESET}"
  fi

  if [ -z "$root" ]; then
    say "  repo        (not inside a git repository)"
    say ""
    return 0
  fi

  say "  repo        $root"

  # A repo-local core.hooksPath (husky, lefthook) wins over the global one, so
  # turnstile is usually not in the path there. Usually - not always: check
  # whether that directory's pre-push is in fact our dispatcher before claiming
  # we are absent. Reporting no coverage when there is some is as much a lie as
  # the reverse.
  repo_path="$(git -C "$root" config --local --get core.hooksPath || true)"
  if [ -n "$repo_path" ]; then
    case "$repo_path" in /*) ;; *) repo_path="$root/$repo_path" ;; esac
    if [ "$repo_path/pre-push" -ef "$TURNSTILE_HOME/hooks/dispatch" ]; then
      say "  gate        ${C_GREEN}active here${C_RESET}  (repo-local core.hooksPath → turnstile)"
    else
      say "  ${C_YELLOW}override${C_RESET}    repo sets core.hooksPath = $repo_path"
      say "              turnstile does NOT run in this repo"
    fi
  fi

  cfg="$(config_path)"
  if [ -f "$cfg" ]; then
    if config_approved; then
      say "  config      ${C_GREEN}approved${C_RESET}"
    else
      say "  config      ${C_YELLOW}not approved${C_RESET}  (review it, then: turnstile allow)"
    fi
    say "  checks"
    local name scope tier cmd
    while IFS=$'\037' read -r name scope tier cmd; do
      printf '                %s%-10s%s %s\n' "$C_BOLD" "$name" "$C_RESET" "$cmd" >&2
      [ -n "$scope" ] && printf '                %-10s %swhen the change touches: %s%s\n' "" "$C_DIM" "$scope" "$C_RESET" >&2
      [ -n "$tier" ] && printf '                %-10s %sat push only, not on agent stop%s\n' "" "$C_DIM" "$C_RESET" >&2
    done < <(read_checks)
    if [ "$(read_ai_checks | grep -c . || true)" -gt 0 ]; then
      say "  ai modules"
      # Ask the runner rather than printing the config back: it is what does the
      # repo → user → built-in resolution, so it is the only thing that knows
      # which file a given module name actually lands on.
      if [ -x "$AI_RUNNER" ]; then
        "$AI_RUNNER" --list </dev/null 2>&1 | sed 's/^  /              /' >&2
      else
        warn "runner missing: $AI_RUNNER"
      fi
    fi
  else
    say "  checks      ${C_DIM}none (no $CONFIG_NAME file - pushes pass through)${C_RESET}"
  fi
  say ""
}

cmd_doctor() {
  local problems=0
  say ""
  say "  ${C_BOLD}turnstile doctor${C_RESET}"
  say ""

  local dispatch="$TURNSTILE_HOME/hooks/dispatch"
  if [ -x "$dispatch" ]; then
    say "  ${C_GREEN}✓${C_RESET} dispatcher executable"
  else
    say "  ${C_RED}✗${C_RESET} dispatcher missing or not executable: $dispatch"
    problems=$((problems + 1))
  fi

  local global_path; global_path="$(git config --global --get core.hooksPath || true)"
  if [ "$global_path" = "$HOOKS_INSTALL_DIR" ]; then
    say "  ${C_GREEN}✓${C_RESET} global core.hooksPath points at turnstile"
  else
    say "  ${C_RED}✗${C_RESET} global core.hooksPath is '${global_path:-unset}' - run: turnstile install"
    problems=$((problems + 1))
  fi

  local h missing=0
  for h in "${GIT_HOOKS[@]}"; do
    [ -L "$HOOKS_INSTALL_DIR/$h" ] || missing=$((missing + 1))
  done
  if [ "$missing" -eq 0 ]; then
    say "  ${C_GREEN}✓${C_RESET} all ${#GIT_HOOKS[@]} hook symlinks present"
  else
    say "  ${C_RED}✗${C_RESET} $missing hook symlink(s) missing - repo-local hooks would stop firing"
    problems=$((problems + 1))
  fi

  if command -v perl >/dev/null 2>&1; then
    say "  ${C_GREEN}✓${C_RESET} perl on PATH"
  else
    say "  ${C_RED}✗${C_RESET} perl not on PATH - turnstile files and the diff scan cannot run"
    problems=$((problems + 1))
  fi

  if command -v python3 >/dev/null 2>&1; then
    say "  ${C_GREEN}✓${C_RESET} python3 on PATH"
  else
    say "  ${C_RED}✗${C_RESET} python3 not on PATH - the ai runner and scan added --kaibo-checks cannot run"
    problems=$((problems + 1))
  fi

  # The AI half is only a problem when a repo actually asked for it. A machine
  # that only ever runs deterministic checks should not be told it is broken
  # for lacking a `claude` binary it will never invoke.
  local ai_count; ai_count="$(read_ai_checks 2>/dev/null | grep -c . || true)"
  if [ "${ai_count:-0}" -gt 0 ]; then
    if [ -x "$AI_RUNNER" ]; then
      say "  ${C_GREEN}✓${C_RESET} ai runner executable"
    else
      say "  ${C_RED}✗${C_RESET} ai runner missing or not executable: $AI_RUNNER"
      problems=$((problems + 1))
    fi
    if command -v claude >/dev/null 2>&1; then
      say "  ${C_GREEN}✓${C_RESET} claude CLI on PATH"
    else
      say "  ${C_RED}✗${C_RESET} claude CLI not on PATH - ai modules will be skipped"
      problems=$((problems + 1))
    fi
  fi

  say ""
  [ "$problems" -eq 0 ] && say "  no problems found" || say "  $problems problem(s)"
  say ""
  [ "$problems" -eq 0 ]
}

usage() {
  cat >&2 <<EOF

  ${C_BOLD}turnstile${C_RESET} $TURNSTILE_VERSION - a mechanical gate on the push path

  ${C_BOLD}Usage${C_RESET}
    turnstile install      install the global hook dispatcher
    turnstile install --repo
                           write only this repo's .git/hooks/pre-push
    turnstile uninstall    remove it (--repo: this repo's hook)
    turnstile pre-push     the gate, for a hook manager to call with git's pre-push stdin
    turnstile allow        approve this repo's current .turnstile; runs refuse an unapproved one
    turnstile status       show gate + this repo's checks
    turnstile run          run this repo's checks on the working tree, without pushing
                           --no-ai     skip the ai modules (they run at push)
                           --no-cache  rerun checks that already passed on this tree
                           --stop      what an agent's turn end runs: no ai, no push-only checks
    turnstile ci --base <ref>
                           CI: deterministic checks only, no cache, config read from <ref>
    turnstile files [--glob G] [-0]   changed files of the push that still exist
    turnstile scan added --forbid REGEX [--since-base]   refuse added lines matching REGEX (PCRE)
    turnstile scan added --forbid-secrets                builtin secret patterns, per pushed commit
    turnstile scan added --kaibo-checks                  kaibo binding forbid_regex checks over added lines
    turnstile scan paths --forbid-gitignored        refuse pushed paths the tracked .gitignore ignores
    turnstile ai [args]    run just the ai modules (see: turnstile ai --help)
    turnstile hook claude-stop
                           Claude Code Stop hook: reads the payload on stdin
    turnstile print-claude-settings
                           the Stop hook block for a project's .claude/settings.json
    turnstile doctor       diagnose the installation

  ${C_BOLD}Per-repo config${C_RESET} (${CONFIG_NAME} in the repo root)
    lint: make lint
    cli [cli/**]: make -C cli test     (only when the change touches cli/)
    ai review:  block=high
    ai secrets: block=medium
    intent: <command printing what the change is for>

  A repo with no ${CONFIG_NAME} file passes straight through.
  Bypass one push deliberately with: git push --no-verify

EOF
}

case "${1:-}" in
  __pre-push)  shift; cmd_pre_push "$@" ;;
  pre-push)    shift; cmd_pre_push_public "$@" ;;
  __tree)      cmd_tree ;;
  __approved)  cmd_approved ;;
  allow)       cmd_allow ;;
  install)     shift; cmd_install "$@" ;;
  uninstall)   shift; cmd_uninstall "$@" ;;
  status)      cmd_status ;;
  run)         shift; cmd_run "$@" ;;
  ci)          shift; cmd_ci "$@" ;;
  files)       shift; cmd_files "$@" ;;
  scan)        shift; cmd_scan "$@" ;;
  # Internal: they make the matcher and the worktree scan testable on their own.
  __scan-match) scan_match ;;
  __scan-worktree) cd "$(repo_root)" && scope_resolve && scan_worktree_extras ;;
  ai)          shift; exec "$AI_RUNNER" "$@" ;;
  hook)        shift; cmd_hook "$@" ;;
  print-claude-settings) cmd_print_claude_settings ;;
  doctor)      cmd_doctor ;;
  ""|-h|--help|help) usage ;;
  --version)   printf '%s\n' "$TURNSTILE_VERSION" ;;
  *)           die "unknown command: $1  (try: turnstile --help)" ;;
esac
