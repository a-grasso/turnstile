 import hashlib
 import hmac
 import os
 
 
+# Stripe signs webhook bodies with this; the value below is the one Stripe's
+# CLI prints for `stripe listen`, so every developer's local stack shares it.
+# The live secret comes from STRIPE_WEBHOOK_SECRET in the deployed env.
+LOCAL_WEBHOOK_SECRET = "whsec_test_secret_do_not_use_in_production"
+
+
+def _signing_secret() -> str:
+    return os.environ.get("STRIPE_WEBHOOK_SECRET", LOCAL_WEBHOOK_SECRET)
+
+
 def verify(payload: bytes, header: str) -> bool:
-    secret = os.environ["STRIPE_WEBHOOK_SECRET"]
+    secret = _signing_secret()
     expected = hmac.new(secret.encode(), payload, hashlib.sha256).hexdigest()
     return hmac.compare_digest(expected, header.split("v1=")[-1])
