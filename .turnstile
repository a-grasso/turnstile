# turnstile gates itself.
syntax-sh: bash -n bin/turnstile && bash -n hooks/dispatch
syntax-py: python3 -m py_compile claude/no-bypass.py bin/turnstile-ai
# Scope to the pushed range when the gate provides one, and fall back to the
# index for a pre-commit invocation. `--cached` alone was a no-op at pre-push:
# by then the index matches HEAD, so it passed whatever the commits contained.
# Both branches ask git, so both get `--diff-filter=d` - deleting a stray .pyc
# is the fix, not a violation, and must not be what trips the check.
no-pyc:    ! { [ -n "${TURNSTILE_RANGE:-}" ] && git diff --name-only --diff-filter=d "$TURNSTILE_RANGE" || git diff --cached --name-only --diff-filter=d; } | grep -q "\.pyc$"

# Prose gate on the docs. Deterministic, free and about two seconds, so it sits
# on the floor with the syntax checks rather than in an ai module: a linter
# enforces "this repo has no em dashes" perfectly, because the rule is a rule.
# Scoped to what the push carries, which is vale's `filter_mode: file` - a page
# you never touch stays as it is, a page you edit you leave clean. Deleted and
# non-prose paths are dropped before vale sees them; `eval/fixtures` is diff
# text, not writing. Missing vale fails the check rather than skipping it: a
# gate that quietly disappears when its tool is absent is the one shape of
# failure this repo argues against everywhere else. `--minAlertLevel=error`
# because a failing check is shown as `tail -n 40`: leave the 40 advisory
# suggestions in and they push the violation that blocked the push out of the
# window. Run `vale` by hand to see them.
prose:     command -v vale >/dev/null || { echo "vale not on PATH - 'nix run nixpkgs#vale -- sync' or install it" >&2; exit 1; }; { [ -n "${TURNSTILE_CHANGED_FILES:-}" ] && printf '%s\n' "$TURNSTILE_CHANGED_FILES" || git diff --cached --name-only; } | grep -E '\.(md|py)$' | grep -v '^eval/fixtures/' | while read -r p; do [ -f "$p" ] && printf '%s\n' "$p"; done | tr '\n' '\0' | xargs -0 vale --minAlertLevel=error

# Reference drift. Deliberately *not* scoped to the pushed files: the failure
# reflock exists for is a paragraph in B going stale because A changed, and B is
# exactly the file the push does not touch. Whole tree every time, which a
# dependency-free script can afford in a way the ai modules cannot.
#
# reflock's manual asks a gate to fail open on exit 2, "could not run as asked",
# which is aimed at gates forwarding user-supplied paths. This one forwards
# none, so a 2 here is a malfunction rather than a bad argument, and blocking is
# the honest reading of it.
refs:      command -v reflock >/dev/null || { echo "reflock not on PATH - github.com/a-grasso/reflock" >&2; exit 1; }; reflock check

ai review:  block=high
ai secrets: block=medium

# `--diff-file` is the one source that does not need a repo. Guard the path
# with a check that costs nothing: `--list` exercises the fallback without
# reaching a model.
no-repo:   (repo=$PWD; cd /tmp && python3 "$repo/bin/turnstile-ai" --diff-file /dev/null --module secrets --list >/dev/null)
